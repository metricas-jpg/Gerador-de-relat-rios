# Endereço público do app na Vercel
NEXTAUTH_URL=https://monitor-crise.vercel.app
# Gere com: openssl rand -base64 32
NEXTAUTH_SECRET=

# Login Google (pode ser o mesmo cliente OAuth do Portal de Relatórios,
# adicionando a URL de callback deste app: https://SEU-DOMINIO/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Quem pode entrar (pelo menos um dos dois precisa estar preenchido)
ALLOWED_EMAIL_DOMAINS=loggia.com.br
ALLOWED_EMAILS=

# Service Account (pode ser a mesma do Portal de Relatórios)
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Pasta num Drive compartilhado onde ficam os relatórios (JSON)
DRIVE_FOLDER_ID=
# Opcional: pasta separada para os prints. Se vazio, usa a mesma pasta.
DRIVE_UPLOADS_FOLDER_ID=
